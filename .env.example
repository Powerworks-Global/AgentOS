# Copy to .env and fill in. The pilot drives the `claude` CLI directly
# (already authenticated on this machine), so no API key is required
# unless you want to point the SDK at a different auth mode.

# Repo the pipeline is allowed to touch. Must be a git repo with a clean
# working tree when a run starts.
PILOT_REPO_ROOT=/absolute/path/to/target/repo

# Feature branch prefix the pipeline creates branches under, e.g. pilot/
PILOT_BRANCH_PREFIX=pilot/

# Where per-run tool-permission decisions are logged (JSONL), for review.
PILOT_AUDIT_LOG=./audit/decisions.jsonl

# Task queue directory for the inbox/worker (pending/processing/done/failed
# subfolders, created automatically). A task's own repo_root (set via
# `inbox add --repo`) overrides PILOT_REPO_ROOT above for that task only.
PILOT_INBOX_DIR=./inbox

# Where per-run cost/outcome metrics are logged (JSONL) - one record per
# completed run: cost, token usage, turns, success/failure, permission
# denials. This is the baseline `agentos_pilot.report` reads from.
PILOT_METRICS_LOG=./audit/runs.jsonl

# Optional. Both unset = no Telegram notifications (default, silent no-op).
# Set both to get a post-run summary (success/failure, cost, turns,
# permission denials) sent via worker.py's scheduled runs - see notify.py.
# Create a bot via @BotFather on Telegram to get a token; TELEGRAM_CHAT_ID is
# the numeric chat id notifications should be sent to.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
